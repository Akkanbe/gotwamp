{
  "title": "gotwamp overview",
  "uid": "gotwamp-overview",
  "tags": [
    "gotwamp",
    "twamp"
  ],
  "description": "TWAMP measurements and reflector of gotwampd (docs/ops/metrics.md).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gotwamp_build_info, instance)",
          "refId": "instance"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gotwamp_sender_packets_sent_total{instance=~\"$instance\"}, session)",
          "refId": "session"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sender (monitoring sessions)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "RTT p95 / median / min (latest run)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_rtt_seconds{instance=~\"$instance\", session=~\"$session\", stat=\"p95\"}",
          "legendFormat": "{{session}} p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_rtt_seconds{instance=~\"$instance\", session=~\"$session\", stat=\"median\"}",
          "legendFormat": "{{session}} median"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_rtt_seconds{instance=~\"$instance\", session=~\"$session\", stat=\"min\"}",
          "legendFormat": "{{session}} min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "RTT excluding the reflector's processing time, per run or window."
    },
    {
      "id": 3,
      "title": "Loss ratio (latest run)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_loss_ratio{instance=~\"$instance\", session=~\"$session\"}",
          "legendFormat": "{{session}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "RTT distribution (p50 / p99 over 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (session, le) (rate(gotwamp_sender_rtt_seconds_bucket{instance=~\"$instance\", session=~\"$session\"}[5m])))",
          "legendFormat": "{{session}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (session, le) (rate(gotwamp_sender_rtt_seconds_bucket{instance=~\"$instance\", session=~\"$session\"}[5m])))",
          "legendFormat": "{{session}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "From the per-packet histogram; bucket bounds come from daemon.metrics.rtt_buckets."
    },
    {
      "id": 5,
      "title": "One-way delay median (valid only)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_forward_delay_seconds{instance=~\"$instance\", session=~\"$session\", stat=\"median\"}",
          "legendFormat": "{{session}} forward"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_reverse_delay_seconds{instance=~\"$instance\", session=~\"$session\", stat=\"median\"}",
          "legendFormat": "{{session}} reverse"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Shown only while both clocks are synchronized (gotwamp_sender_last_run_owd_valid = 1)."
    },
    {
      "id": 6,
      "title": "Jitter (latest run)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_jitter_seconds{instance=~\"$instance\", session=~\"$session\", kind=\"ipdv_mean\"}",
          "legendFormat": "{{session}} IPDV mean"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_jitter_seconds{instance=~\"$instance\", session=~\"$session\", kind=\"pdv_p95\"}",
          "legendFormat": "{{session}} PDV p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_jitter_seconds{instance=~\"$instance\", session=~\"$session\", kind=\"rfc3550\"}",
          "legendFormat": "{{session}} RFC 3550"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Packets per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (session) (rate(gotwamp_sender_packets_sent_total{instance=~\"$instance\", session=~\"$session\"}[5m]))",
          "legendFormat": "{{session}} sent"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (session) (rate(gotwamp_sender_packets_lost_total{instance=~\"$instance\", session=~\"$session\"}[5m]))",
          "legendFormat": "{{session}} lost"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (session, direction) (rate(gotwamp_sender_packets_duplicate_total{instance=~\"$instance\", session=~\"$session\"}[5m]))",
          "legendFormat": "{{session}} dup {{direction}}"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (session) (rate(gotwamp_sender_packets_reordered_total{instance=~\"$instance\", session=~\"$session\"}[5m]))",
          "legendFormat": "{{session}} reordered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Latest run succeeded",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_last_run_success{instance=~\"$instance\", session=~\"$session\"}",
          "legendFormat": "{{session}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red"
                },
                "1": {
                  "text": "ok",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 9,
      "title": "Run errors by stage (1h)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (session, stage) (increase(gotwamp_sender_run_errors_total{instance=~\"$instance\", session=~\"$session\"}[1h]))",
          "legendFormat": "{{session}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Path hops (latest run)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_sender_path_hops{instance=~\"$instance\", session=~\"$session\"}",
          "legendFormat": "{{session}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "row",
      "title": "Reflector",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Reflected packets per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, listener) (rate(gotwamp_reflector_packets_reflected_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{kind}} {{listener}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Dropped packets per second by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, reason) (rate(gotwamp_reflector_packets_dropped_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{kind}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {},
      "description": "acl / rate_limit point at unwanted senders; unknown_session at NAT/PAT (see verify_sender); drained / not_started at clients that send outside their session."
    },
    {
      "id": 14,
      "title": "Sessions and flows with state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_reflector_sessions_active{instance=~\"$instance\"}",
          "legendFormat": "{{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_reflector_control_connections_active{instance=~\"$instance\"}",
          "legendFormat": "control connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Control connections and flow overflow (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(gotwamp_reflector_control_connections_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "connections {{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(gotwamp_reflector_light_flows_overflow_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "light flow overflow"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "row",
      "title": "Daemon",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "title": "Clock synchronized",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_clock_synchronized{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no",
                  "color": "red"
                },
                "1": {
                  "text": "yes",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 18,
      "title": "Clock max error",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 49,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_clock_max_error_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 19,
      "title": "Timestamping mode",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_timestamping_mode{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      }
    },
    {
      "id": 20,
      "title": "Build",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 49,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotwamp_build_info{instance=~\"$instance\"}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
