# Session-Reflector packet answering sender-packet-symmetrical.hex: the
# format is unchanged and the length equals the sender's (RFC 6038 §5.2.2),
# so the 8 octets of padding come back in place, none dropped
00 00 00 03                                         # 0  Sequence Number = 3
ee 6c 15 80 80 01 00 00                             # 4  Timestamp (T3)
00 01                                               # 12 Error Estimate = S=0 Multiplier=1
00 00                                               # 14 MBZ (2)
ee 6c 15 80 80 00 80 00                             # 16 Receive Timestamp (T2)
00 00 00 07                                         # 24 Sender Sequence Number = 7
ee 6c 15 80 80 00 00 00                             # 28 Sender Timestamp (T1)
8a d2                                               # 36 Sender Error Estimate
00 00                                               # 38 MBZ (2)
ff                                                  # 40 Sender TTL = 255
00 01 02 03 04 05 06 07                             # 41 Packet Padding (8) = the sender's, in place
