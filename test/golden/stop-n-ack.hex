# Stop-N-Ack, 32 + 16 x 1 octets (RFC 5938 §3.5): one session refused
0a                                                  # 0  Command Number = 10
05                                                  # 1  Accept = 5 (temporary resource limitation)
00 00                                               # 2  MBZ (2)
00 00 00 00 00 00 00 00                             # 4  MBZ (8)
00 00 00 01                                         # 12 Number of Sessions = 1
c0 00 02 01 ee 6c 15 80 80 00 00 00 00 00 00 02     # 16 SID
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00     # 32 HMAC (zero, unauthenticated)
