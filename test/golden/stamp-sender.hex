# STAMP Session-Sender packet, unauthenticated (RFC 8762 §4.2.1) with the
# SSID of RFC 8972 §3 and two TLVs (RFC 8972 §4), U flag set by the sender
00 00 00 07                                         # 0  Sequence Number = 7
ee 6c 15 80 80 00 00 00                             # 4  Timestamp
8a d2                                               # 12 Error Estimate
12 34                                               # 14 SSID = 0x1234
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00     # 16 MBZ (28)
00 00 00 00 00 00 00 00 00 00 00 00
80 01 00 04 de ad be ef                             # 44 TLV: Flags U, Type 1 Extra Padding, Length 4
80 63 00 02 ab cd                                   # 52 TLV: Flags U, Type 99 (unassigned), Length 2
