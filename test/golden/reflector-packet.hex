# Session-Reflector packet, unauthenticated, 41 octets (RFC 5357 §4.2.1),
# the reply to sender-packet.hex with its 27 octets of padding truncated away
00 00 00 03                                         # 0  Sequence Number = 3 (reflector's own counter)
ee 6c 15 80 80 01 00 00                             # 4  Timestamp (T3)
00 01                                               # 12 Error Estimate = S=0 Z=0 Scale=0 Multiplier=1
00 00                                               # 14 MBZ (2)
ee 6c 15 80 80 00 80 00                             # 16 Receive Timestamp (T2)
00 00 00 07                                         # 24 Sender Sequence Number = 7
ee 6c 15 80 80 00 00 00                             # 28 Sender Timestamp (T1)
8a d2                                               # 36 Sender Error Estimate
00 00                                               # 38 MBZ (2)
ff                                                  # 40 Sender TTL = 255
