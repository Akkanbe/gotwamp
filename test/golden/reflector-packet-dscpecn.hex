# Session-Reflector packet, unauthenticated, DSCP and ECN Monitoring (RFC 7750 §2.2), 44 + 4 octets
00 00 00 2a                                         # 0  Sequence Number = 42
ee 6c 15 80 80 01 00 00                             # 4  Timestamp (T3)
c0 05                                               # 12 Error Estimate = S=1 Z=1 Scale=0 Multiplier=5
00 00                                               # 14 MBZ (2)
ee 6c 15 80 80 00 80 00                             # 16 Receive Timestamp (T2)
00 00 00 2a                                         # 24 Sender Sequence Number = 42
ee 6c 15 80 80 00 00 00                             # 28 Sender Timestamp (T1)
8a d2                                               # 36 Sender Error Estimate
00 00                                               # 38 MBZ (2)
fe                                                  # 40 Sender TTL = 254
ba                                                  # 41 S-DSCP-ECN = DSCP 46 (EF), ECN 2 (ECT(0))
00 00                                               # 42 MBZ (2)
de ad be ef                                         # 44 Packet Padding (4)
